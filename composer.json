{
    "name": "nickfairchild/kinsta-php-sdk",
    "description": "PHP SDK for Kinsta WordPress Hosting API",
    "keywords": [
        "kinsta", "wordpress", "api", "sdk"
    ],
    "homepage": "https://github.com/nickfairchild/kinsta-php-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "Nick Fairchild",
            "email": "nick.fairchild@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "saloonphp/saloon": "^4.0",
        "saloonphp/pagination-plugin": "^2.0",
        "symfony/var-dumper": "^7.4|^8.0"
    },
    "require-dev": {
        "jonpurvis/lawman": "^4.2",
        "laravel/pint": "^1.29",
        "pestphp/pest": "^4.7",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Nickfairchild\\KinstaPhpSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nickfairchild\\KinstaPhpSdk\\Tests\\": "tests"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest -p",
        "analyse": "vendor/bin/phpstan analyse",
        "baseline": "vendor/bin/phpstan analyse --generate-baseline"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true
        }
    }
}
